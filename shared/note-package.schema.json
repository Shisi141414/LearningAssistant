{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LearningAssistant portable note 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schema_version",
    "document",
    "exported_at",
    "sources",
    "state",
    "origins",
    "assets",
    "annotations",
    "concepts",
    "evidence"
  ],
  "properties": {
    "format": {
      "const": "learning-assistant/note"
    },
    "schema_version": {
      "const": "0.1"
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "note_id",
        "revision_id",
        "title",
        "created_at",
        "subject_name"
      ],
      "properties": {
        "id": {
          "$ref": "material#/$defs/id"
        },
        "note_id": {
          "$ref": "material#/$defs/id"
        },
        "revision_id": {
          "$ref": "material#/$defs/id"
        },
        "title": {
          "type": "string",
          "maxLength": 500,
          "pattern": "^[^\\u0000]*$"
        },
        "created_at": {
          "$ref": "material#/$defs/time"
        },
        "subject_name": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "maxLength": 500,
              "pattern": "^[^\\u0000]*$"
            }
          ]
        }
      }
    },
    "exported_at": {
      "$ref": "material#/$defs/time"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "ordinal",
          "raw_text",
          "heading",
          "locator_json",
          "extraction"
        ],
        "properties": {
          "id": {
            "$ref": "material#/$defs/id"
          },
          "ordinal": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4999
          },
          "raw_text": {
            "type": "string",
            "maxLength": 2000000,
            "pattern": "^[^\\u0000]*$"
          },
          "heading": {
            "type": "string",
            "maxLength": 10000,
            "pattern": "^[^\\u0000]*$"
          },
          "locator_json": {
            "type": "string",
            "maxLength": 2000,
            "pattern": "^[^\\u0000]*$"
          },
          "extraction": {
            "const": "native"
          }
        }
      }
    },
    "state": {
      "$ref": "material#/properties/state"
    },
    "origins": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 5000,
      "propertyNames": {
        "$ref": "material#/$defs/id"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "segment_id",
          "segment_revision",
          "raw_text",
          "organized_by",
          "model",
          "recorded_at",
          "updated_at",
          "material_ref"
        ],
        "properties": {
          "segment_id": {
            "$ref": "material#/$defs/id"
          },
          "segment_revision": {
            "$ref": "material#/$defs/time"
          },
          "raw_text": {
            "type": "string",
            "maxLength": 2000000,
            "pattern": "^[^\\u0000]*$"
          },
          "organized_by": {
            "enum": [
              "initial",
              "ai",
              "user"
            ]
          },
          "model": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "maxLength": 1000,
                "pattern": "^[^\\u0000]*$"
              }
            ]
          },
          "recorded_at": {
            "$ref": "material#/$defs/time"
          },
          "updated_at": {
            "$ref": "material#/$defs/time"
          },
          "material_ref": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "version_id",
                  "ordinal",
                  "heading",
                  "text",
                  "locator_json",
                  "material_id",
                  "material_title",
                  "file_name",
                  "format"
                ],
                "properties": {
                  "id": {
                    "$ref": "material#/$defs/id"
                  },
                  "version_id": {
                    "$ref": "material#/$defs/id"
                  },
                  "ordinal": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100000
                  },
                  "heading": {
                    "type": "string",
                    "maxLength": 10000,
                    "pattern": "^[^\\u0000]*$"
                  },
                  "text": {
                    "type": "string",
                    "maxLength": 200000,
                    "pattern": "^[^\\u0000]*$"
                  },
                  "locator_json": {
                    "type": "string",
                    "maxLength": 2000,
                    "pattern": "^[^\\u0000]*$"
                  },
                  "material_id": {
                    "$ref": "material#/$defs/id"
                  },
                  "material_title": {
                    "type": "string",
                    "maxLength": 500,
                    "pattern": "^[^\\u0000]*$"
                  },
                  "file_name": {
                    "type": "string",
                    "maxLength": 500,
                    "pattern": "^[^\\u0000]*$"
                  },
                  "format": {
                    "enum": [
                      "pdf",
                      "docx",
                      "pptx",
                      "doc",
                      "ppt"
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "maxItems": 0
    },
    "annotations": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source_id",
          "kind",
          "anchor_json",
          "comment",
          "created_at",
          "matches_revision",
          "segment_revision"
        ],
        "properties": {
          "id": {
            "$ref": "material#/$defs/id"
          },
          "source_id": {
            "$ref": "material#/$defs/id"
          },
          "kind": {
            "enum": [
              "keypoint",
              "question"
            ]
          },
          "anchor_json": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "maxLength": 10000,
                "pattern": "^[^\\u0000]*$"
              }
            ]
          },
          "comment": {
            "type": "string",
            "maxLength": 200000,
            "pattern": "^[^\\u0000]*$"
          },
          "created_at": {
            "$ref": "material#/$defs/time"
          },
          "matches_revision": {
            "type": "boolean"
          },
          "segment_revision": {
            "$ref": "material#/$defs/time"
          }
        }
      }
    },
    "concepts": {
      "$ref": "material#/properties/concepts"
    },
    "evidence": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "concept_id",
          "source_id",
          "field",
          "quote",
          "quote_sha256",
          "role",
          "memo",
          "created_at",
          "matches_revision"
        ],
        "properties": {
          "concept_id": {
            "$ref": "material#/$defs/id"
          },
          "source_id": {
            "$ref": "material#/$defs/id"
          },
          "field": {
            "enum": [
              "raw_text",
              "organized_text"
            ]
          },
          "quote": {
            "type": "string",
            "maxLength": 40000,
            "pattern": "^[^\\u0000]*$"
          },
          "quote_sha256": {
            "$ref": "material#/$defs/hash"
          },
          "role": {
            "enum": [
              "source",
              "definition",
              "proof",
              "example",
              "counterexample",
              "application"
            ]
          },
          "memo": {
            "type": "string",
            "maxLength": 2000,
            "pattern": "^[^\\u0000]*$"
          },
          "created_at": {
            "$ref": "material#/$defs/time"
          },
          "matches_revision": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
