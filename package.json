{
  "name": "learning-assistant",
  "productName": "LearningAssistant",
  "version": "0.1.0",
  "description": "面向大学生的 AI 学习助手桌面应用",
  "main": "./out/main/index.js",
  "author": "hhq & claude",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test:db": "node --experimental-strip-types scripts/smoke-db.ts",
    "test:organize": "node --experimental-strip-types scripts/smoke-organize.ts",
    "test:chunk": "node --experimental-strip-types scripts/smoke-chunk.ts",
    "test": "npm run test:db && npm run test:organize && npm run test:chunk && npm run test:reliability && npm run test:materials && node scripts/test-note-learning.cjs && node scripts/test-learning-pdf.cjs && node scripts/test-classroom-learning.cjs && node scripts/test-note-ai.cjs && node scripts/test-note-package.cjs && node scripts/test-note-package-import.cjs && node scripts/test-projects-schedule.cjs && node scripts/test-calendar-management.cjs && node scripts/test-exercises.cjs && node scripts/test-knowledge-graph.cjs && node scripts/test-project-documents.cjs && node scripts/test-exercise-sets.cjs && node scripts/test-task-resources.cjs && node scripts/test-auto-schedule.cjs && node scripts/test-reminders.cjs && node scripts/test-continuous-schedule.cjs && node scripts/test-schedule-block-move.cjs && node scripts/test-memos.cjs && node scripts/test-memo-auto.cjs",
    "test:project-documents": "npm run build && node scripts/test-project-documents.cjs",
    "test:graph": "npm run build && node scripts/test-knowledge-graph.cjs",
    "test:exercises": "npm run build && node scripts/test-exercises.cjs",
    "test:calendar": "npm run build && node scripts/test-calendar-management.cjs",
    "test:projects": "npm run build && node scripts/test-projects-schedule.cjs",
    "test:note-import": "npm run build && node scripts/test-note-package-import.cjs",
    "test:note-package": "npm run build && node scripts/test-note-package.cjs && node scripts/test-note-package-import.cjs",
    "test:note-ai": "npm run build && node scripts/test-note-ai.cjs",
    "test:classroom": "npm run build && node scripts/test-classroom-learning.cjs",
    "test:notes": "npm run build && node scripts/test-note-learning.cjs",
    "test:pdf": "npm run build && node scripts/test-learning-pdf.cjs",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "build:win": "electron-vite build && electron-builder --win",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "test:reliability": "node --import ./scripts/test-support.mjs --test scripts/*.test.mjs",
    "test:materials": "npm run build && node scripts/test-materials.cjs",
    "test:ocr": "npm run build && node scripts/test-ocr.cjs",
    "test:exercise-sets": "npm run build && node scripts/test-exercise-sets.cjs",
    "test:task-resources": "npm run build && node scripts/test-task-resources.cjs",
    "test:auto-schedule": "npm run build && node scripts/test-auto-schedule.cjs",
    "test:reminders": "npm run build && node scripts/test-reminders.cjs",
    "test:continuous-schedule": "npm run build && node scripts/test-continuous-schedule.cjs",
    "test:block-move": "npm run build && node scripts/test-schedule-block-move.cjs",
    "test:memos": "npm run build && node scripts/test-memos.cjs",
    "test:memo-auto": "npm run build && node scripts/test-memo-auto.cjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.3",
    "@fullcalendar/core": "6.1.21",
    "@fullcalendar/daygrid": "6.1.21",
    "@fullcalendar/interaction": "6.1.21",
    "@fullcalendar/react": "6.1.21",
    "@fullcalendar/timegrid": "6.1.21",
    "@js-temporal/polyfill": "0.5.1",
    "@napi-rs/canvas": "^1.1.0",
    "@tiptap/core": "3.33.1",
    "@tiptap/extension-document": "3.33.1",
    "@tiptap/extension-hard-break": "3.33.1",
    "@tiptap/extension-paragraph": "3.33.1",
    "@tiptap/extension-text": "3.33.1",
    "@tiptap/extensions": "3.33.1",
    "@tiptap/pm": "3.33.1",
    "@tiptap/react": "3.33.1",
    "@xyflow/react": "12.12.1",
    "ahocorasick": "^1.0.2",
    "ajv": "8.20.0",
    "better-sqlite3": "^13.0.3",
    "ical.js": "2.2.1",
    "image-size": "2.1.0",
    "katex": "^0.19.1",
    "mathlive": "0.111.4",
    "nanoid": "^6.0.2",
    "officeparser": "^8.7.1",
    "onnxruntime-node": "1.23.2",
    "openai": "^7.54.0",
    "pdfjs-dist": "^6.5.438",
    "ppu-paddle-ocr": "^6.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tesseract.js": "^7.0.0",
    "yauzl": "3.4.0",
    "yazl": "3.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "fflate": "^0.8.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  },
  "overrides": {
    "tesseract.js": {
      "wasm-feature-detect": "1.8.0"
    }
  },
  "allowScripts": {
    "electron@45.2.3": true,
    "better-sqlite3@13.0.3": true,
    "sherpa-onnx-node@2.0.1": true
  },
  "optionalDependencies": {
    "sherpa-onnx-node": "^2.0.1"
  },
  "engines": {
    "node": ">=22.23.4 <23 || >=24.22.1 <25 || >=26.12.1"
  }
}
